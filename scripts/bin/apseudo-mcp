#!/usr/bin/env bash
# Compatibility entrypoint for callers that invoke scripts/bin/apseudo-mcp.
# The runnable MCP wrapper lives under integrations/mcp/ so active configs target it.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
exec "$ROOT/integrations/mcp/apseudo-mcp" "$@"
